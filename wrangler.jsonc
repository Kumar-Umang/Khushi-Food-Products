{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khushi-food-products",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "routes": [
    { "pattern": "khushifoodproducts.in", "custom_domain": true },
    { "pattern": "controlpanel.khushifoodproducts.in", "custom_domain": true },
    { "pattern": "stockandbilling.khushifoodproducts.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khushi-food-products-db"
    }
  ]
}
